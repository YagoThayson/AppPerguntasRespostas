<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_escuro">

    <ImageView
        android:id="@+id/ImagemInicial"
        android:layout_width="332dp"
        android:layout_height="194dp"
        android:layout_marginTop="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_launcher_foreground" />

    <EditText
        android:id="@+id/NomeDeUsuario"
        android:layout_width="332dp"
        android:layout_height="48dp"
        android:background="@drawable/text_view_arredondado"
        android:fontFamily="@font/inter"
        android:gravity="center_vertical|start"
        android:paddingStart="18dp"
        android:inputType="text"
        android:hint="Digite Seu Nome"
        android:maxLength="20"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/IniciarPartida"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ImagemInicial" />

    <Button
        android:id="@+id/IniciarPartida"
        android:layout_width="332dp"
        android:layout_height="112dp"
        android:layout_marginBottom="80dp"
        android:text="INICIAR PARTIDA"
        android:textSize="32sp"
        android:textAlignment="center"
        android:textColor="@color/cinza_claro"
        android:backgroundTint="@color/azul_vivo"
        app:layout_constraintBottom_toTopOf="@+id/Historico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/Historico"
        android:layout_width="332dp"
        android:layout_height="112dp"
        android:layout_marginBottom="123dp"
        android:text="HISTÓRICO"
        android:textSize="32sp"
        android:textAlignment="center"
        android:textColor="@color/cinza_claro"
        android:backgroundTint="@color/azul_vivo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment_generico"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>